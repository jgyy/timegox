const REGION_LORE := {}

## next area to enter when travelling from `from` to `to` (breadth-first over portals)
static func next_hop(from: String, to: String) -> String:
	if from == to:
		return from
	var prev := {from: ""}
	var q: Array = [from]
	var i := 0
	while i < q.size():
		var c: String = q[i]
		i += 1
		for p in AREAS[c].get("portals", []):
			if not prev.has(p.to):
				prev[p.to] = c
				q.append(p.to)
	if not prev.has(to):
		return ""
	var cur := to
	while prev[cur] != from:
		cur = prev[cur]
	return cur

