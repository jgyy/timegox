static var _scenes := {}
static var _meshes := {}
static var _exists := {}
static var disabled := false

static func path(rel: String) -> String:
	return DIR + rel + ".glb"

static func has(rel: String) -> bool:
	if disabled:
		return false
	if not _exists.has(rel):
		_exists[rel] = ResourceLoader.exists(path(rel))
	return _exists[rel]

static func has_monster(shape: String) -> bool:
	return MONSTERS.has(shape) and has(MONSTERS[shape])

static func _scene(rel: String) -> PackedScene:
	if not _scenes.has(rel):
		_scenes[rel] = load(path(rel))
	return _scenes[rel]

static func _material_for(src: Material, actor: bool = false) -> Material:
	var nm := src.resource_name if src != null else "toon"
	if nm.begins_with("glow"):
		return MB.mat_glow()
	if nm.begins_with("plain"):
		return MB.mat_actor_plain() if actor else MB.mat_plain()
	return MB.mat_actor() if actor else MB.mat_vc()

## characters, monsters and mounts (rigged assets) use the actor shading; props keep the scenery toon
static func is_actor(rel: String) -> bool:
	return rel.begins_with("characters/") or rel.begins_with("monsters/") or rel.begins_with("mounts/")

## Accent colours by element: small, saturated focal colours (a fire beast's eyes, crest and spines
## glow gold, a water beast's cyan ...), each with an alternate for bodies already of that hue.
const ELEM_ACCENT := {
	"fire": [Color("ffc21a"), Color("ff3a22")],  # gold; red on a golden body
	"water": [Color("2ad4ff"), Color("ffb03a")],  # cyan; warm gold on a blue body
	"wood": [Color("a6f03c"), Color("ff7ab8")],  # spring green; blossom pink on a green body
	"earth": [Color("ff9a2a"), Color("3ad8b0")],  # amber; turquoise on a brown body
	"thunder": [Color("b47cff"), Color("ffe83a")],  # violet; electric yellow on a violet body
	"dark": [Color("ff3c8c"), Color("3af0e0")],  # magenta; spectral cyan on a red-violet body
	"phys": [Color("ff4a3a"), Color("ffd23a")],  # red; gold on a red body
}

## distance between two hues round the colour wheel (0 .. 0.5)
static func hue_gap(a: float, b: float) -> float:
	var d := fposmod(a - b, 1.0)
	return minf(d, 1.0 - d)

## The palette one enemy expands into (sRGB): [dominant, shadow, highlight, secondary, accent,
## underside, markings].  It follows the usual rules for creature colour: one dominant hue over
## most of the body; a secondary set clearly apart from it in hue *and* value (greens and blues
## lean to warmer golds and teals, reds to gold, oranges to a deeper red-brown); a pale,
## cream-leaning underside (countershading); markings that contrast in value (dark on a light
## coat, pale on a dark one); and one small saturated accent for the focal points, the element's
## colour (its alternate, or else the complement, when it sits too close to the body's hue to
## pop).  `over` may pin any of "sec", "acc", "under", "mark" (the classic creatures).
static func palette(c: Color, elem: String = "", over: Dictionary = {}) -> Array:
	var h := c.h
	var s := c.s
	var v := c.v
	var grey := s < 0.14
	var shade := Color.from_hsv(fposmod(h + 0.045, 1.0), minf(1.0, s * 1.2 + 0.05), v * 0.72)
	var light := Color.from_hsv(fposmod(h - 0.035, 1.0), s * 0.75, minf(1.0, v * 1.1 + 0.06))
	var step := 0.13
	if h >= 0.2 and h < 0.66:
		step = -0.13
	elif h >= 0.04 and h < 0.17:
		step = -0.07
	var sv := v * 0.68 if v > 0.55 else minf(1.0, v * 1.35 + 0.14)
	var sec := Color.from_hsv(fposmod(h + step, 1.0), clampf(s * 0.95 + 0.05, 0.0, 0.9), sv)
	if grey:
		sec = Color.from_hsv(0.6 if v > 0.5 else 0.07, 0.24, clampf(v * 0.7, 0.24, 0.9))
	# countershading: paler and less saturated, drifting a third of the way towards cream
	var to_cream := fposmod(0.11 - h + 0.5, 1.0) - 0.5
	var under := Color.from_hsv(fposmod(h + to_cream * 0.33, 1.0), s * 0.3, clampf(maxf(v, 0.4) * 0.3 + 0.64, 0.0, 0.97))
	var mark := Color.from_hsv(fposmod(h + 0.02, 1.0), clampf(s * 0.55 + 0.22, 0.0, 0.85), clampf(v * 0.33, 0.07, 0.3))
	if v < 0.42:
		mark = Color.from_hsv(fposmod(h - 0.06, 1.0), s * 0.35, 0.86)
	var acc := Color("e0b040") if v > 0.45 else Color("70a0ff")
	if ELEM_ACCENT.has(elem):
		var pair: Array = ELEM_ACCENT[elem]
		acc = pair[0]
		if not grey and hue_gap(acc.h, h) < 0.07:
			acc = pair[1]
	if not grey and (not ELEM_ACCENT.has(elem) or hue_gap(acc.h, h) < 0.07):
		acc = Color.from_hsv(fposmod(h + 0.5, 1.0), clampf(s + 0.3, 0.6, 0.95), 1.0)
	sec = over.get("sec", sec)
	acc = over.get("acc", acc)
	under = over.get("under", under)
	mark = over.get("mark", mark)
	return [c, shade, light, sec, acc, under, mark]

## Rebuild a mesh with the game's materials, tinting vertices by their UV.x weight and palette slot
## (`pal` from `palette()`; empty keeps the authored colours).
static func prepare_mesh(src: Mesh, pal: Array, key: String, actor: bool = false) -> Mesh:
	if _meshes.has(key):
		return _meshes[key]
	var out := ArrayMesh.new()
	var lin: Array = []
	for pc in pal:
		lin.append((pc as Color).srgb_to_linear())
	for s in src.get_surface_count():
		var arr: Array = src.surface_get_arrays(s)
		var mat: Material = _material_for(src.surface_get_material(s), actor)
		if not pal.is_empty() and arr[Mesh.ARRAY_TEX_UV] != null and arr[Mesh.ARRAY_COLOR] != null:
			var cols: PackedColorArray = arr[Mesh.ARRAY_COLOR]
			var uvs: PackedVector2Array = arr[Mesh.ARRAY_TEX_UV]
			for i in cols.size():
				var k: float = uvs[i].x
				if k > 0.001:
					var c := cols[i]
					var tl := _tint_for(lin, c, clampf(1.0 - uvs[i].y, 0.0, 1.0))
					cols[i] = Color(lerpf(c.r, c.r * tl.r, k), lerpf(c.g, c.g * tl.g, k), lerpf(c.b, c.b * tl.b, k), c.a)
			arr[Mesh.ARRAY_COLOR] = cols
		var flags: int = src.surface_get_format(s) & Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS
		out.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr, [], {}, flags)
		out.surface_set_material(out.get_surface_count() - 1, mat)
	_meshes[key] = out
	return out

## Linear tint for one vertex: the dominant runs from the cool shadow (dark authored greys) through
## the base colour to the warm highlight (pale greys); 0..0.2 blends it into the underside, 0.5 is
## the secondary, 0.6..0.8 blends it into the markings, 1 is the accent.
static func _tint_for(lin: Array, c: Color, slot: float) -> Color:
	var lum := sqrt(clampf(c.r * 0.3 + c.g * 0.55 + c.b * 0.15, 0.0, 1.0))
	var prim: Color = lin[0]
	prim = prim.lerp(lin[1], smoothstep(0.62, 0.3, lum) * 0.8)
	prim = prim.lerp(lin[2], smoothstep(0.78, 1.0, lum) * 0.6)
	if slot < 0.005:
		return prim
	if slot <= 0.21:
		return prim.lerp(lin[5], clampf(slot / 0.2, 0.0, 1.0))
	if slot < 0.56:
		return lin[3]
	if slot <= 0.81:
		return prim.lerp(lin[6], clampf((slot - 0.6) / 0.2, 0.0, 1.0))
	return lin[4]

static func _walk(n: Node, out: Array, cls: String) -> void:
	if n.is_class(cls):
		out.append(n)
	for c in n.get_children():
		_walk(c, out, cls)

## Instance an asset.  tint.a == 0 keeps the authored colours; `pal` (from `palette()`) overrides
## the palette derived from the tint alone.
static func instance(rel: String, tint: Color = Color(0, 0, 0, 0), pal: Array = []) -> Node3D:
	var inst: Node3D = _scene(rel).instantiate()
	var meshes: Array = []
	_walk(inst, meshes, "MeshInstance3D")
	if pal.is_empty() and tint.a > 0.0:
		pal = palette(tint)
	var sig := "-"
	if not pal.is_empty():
		sig = ""
		for pc in pal:
			sig += (pc as Color).to_html(false)
	for mi in meshes:
		var m: MeshInstance3D = mi
		m.mesh = prepare_mesh(m.mesh, pal, "%s|%s|%s" % [rel, m.name, sig], is_actor(rel))
	var aps: Array = []
	_walk(inst, aps, "AnimationPlayer")
	var root := Node3D.new()
	root.name = rel.get_file()
	root.add_child(inst)
	if not aps.is_empty():
		var ap: AnimationPlayer = aps[0]
		ap.callback_mode_process = AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_MANUAL
		for an in ap.get_animation_list():
			var a: Animation = ap.get_animation(an)
			a.loop_mode = Animation.LOOP_LINEAR if an in LOOPS else Animation.LOOP_NONE
		root.set_meta("ap", ap)
	root.set_meta("glb", rel)
	root.set_meta("meshes", meshes)
	if rel.begins_with("characters/"):
		add_springs(root)
	return root

## The Spring Thunder release: secondary motion the way gacha games give it, by spring bones.  The hair's
## tail, the cape, the hanging pockets of the sleeves and the four panels of the robe each get a chain
## of Godot's SpringBoneSimulator3D (a VRM-style spring, after the defaults of UniVRM and the tuning
## guides of VRoid and VRChat PhysBones: see the README's references): every frame it pulls each bone
## back towards where the baked clip puts it (stiffness), damps it (drag) and lets it hang (gravity), so
## when Lin Feng turns, stops or gallops his hair and cape swing on a beat behind him instead of being
## nailed to the clip.  Robe panels are stiffer than hair, so they never swing through the legs.  On
## screen only: headless there is nothing to see.
## [root bone, end bone, stiffness, drag, gravity, radius]
const SPRINGS := [["hair_tail", "hair_tail2", 1.6, 0.45, 0.15, 0.04], ["cape", "cape3", 1.3, 0.5, 0.2, 0.05],
	["robe_f", "robe_f", 3.6, 0.55, 0.05, 0.06], ["robe_b", "robe_b", 3.0, 0.55, 0.06, 0.06],
	["robe_l", "robe_l", 3.6, 0.55, 0.05, 0.06], ["robe_r", "robe_r", 3.6, 0.55, 0.05, 0.06],
	["sleeve.L", "sleeve.L", 2.6, 0.5, 0.12, 0.04], ["sleeve.R", "sleeve.R", 2.6, 0.5, 0.12, 0.04]]

static func add_springs(root: Node3D) -> SpringBoneSimulator3D:
	if DisplayServer.get_name() == "headless" or not ClassDB.class_exists("SpringBoneSimulator3D"):
		return null
	var sk := _skeleton(root)
	if sk == null:
		return null
	var have: Array = []
	for c in SPRINGS:
		if sk.find_bone(str(c[0])) >= 0 and sk.find_bone(str(c[1])) >= 0:
			have.append(c)
	if have.is_empty():
		return null
	var sb := SpringBoneSimulator3D.new()
	sb.name = "springs"
	sk.add_child(sb)
	sb.setting_count = have.size()
	for i in have.size():
		var c: Array = have[i]
		sb.set_root_bone_name(i, str(c[0]))
		sb.set_end_bone_name(i, str(c[1]))
		# (the last bone of a chain swings on a tail of its own length)
		sb.set_extend_end_bone(i, true)
		sb.set_end_bone_direction(i, SpringBoneSimulator3D.BONE_DIRECTION_FROM_PARENT)
		sb.set_end_bone_length(i, 0.3)
		sb.set_stiffness(i, float(c[2]))
		sb.set_drag(i, float(c[3]))
		sb.set_gravity(i, float(c[4]))
		sb.set_radius(i, float(c[5]))
	root.set_meta("springs", sb)
	return sb

## The hero as the player made and dressed him (fashion.gd): his look's model with parts recoloured.
## `cols` may hold "robe" (the robe: cloth on the primary slot), "sec" (trousers, sash, boots and cape:
## cloth on the secondary slot), "trim" (collar and trims: cloth on the accent slot), "hair" (the hair
## class) and "eyes" (the irises); a part left out keeps its authored colour, so with no colours this
## is the plain asset.  Every recoloured vertex keeps its brightness relative to its part's average,
## so the baked occlusion, the folds, the embroidery and the hair's sheen all survive the dye.
static func hero_instance(rel: String, cols: Dictionary) -> Node3D:
	if cols.is_empty():
		return instance(rel)
	var inst: Node3D = _scene(rel).instantiate()
	var meshes: Array = []
	_walk(inst, meshes, "MeshInstance3D")
	var sig := ""
	for k in ["robe", "sec", "trim", "hair", "eyes"]:
		sig += (cols[k] as Color).to_html(false) if cols.has(k) else "-"
	for mi in meshes:
		var m: MeshInstance3D = mi
		m.mesh = _hero_mesh(m.mesh, cols, "%s|%s|hero:%s" % [rel, m.name, sig])
	var aps: Array = []
	_walk(inst, aps, "AnimationPlayer")
	var root := Node3D.new()
	root.name = rel.get_file()
	root.add_child(inst)
	if not aps.is_empty():
		var ap: AnimationPlayer = aps[0]
		ap.callback_mode_process = AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_MANUAL
		for an in ap.get_animation_list():
			var a: Animation = ap.get_animation(an)
			a.loop_mode = Animation.LOOP_LINEAR if an in LOOPS else Animation.LOOP_NONE
		root.set_meta("ap", ap)
	root.set_meta("glb", rel)
	root.set_meta("meshes", meshes)
	add_springs(root)
	return root

## Which recolourable part of a person a vertex belongs to ("" for none): cloth by its palette slot,
## the hair, and the irises (crystal in the unoutlined surface, at eye height).
static func hero_part(col: Color, uv: Vector2, pos: Vector3, plain: bool) -> String:
	var cls := col.a
	if cls >= 0.94:
		var slot := 1.0 - uv.y
		return "robe" if slot < 0.25 else ("sec" if slot < 0.75 else "trim")
	if cls >= 0.15 and cls <= 0.25:
		return "hair"
	if plain and cls >= 0.45 and cls <= 0.55 and pos.y > 1.5:
		return "eyes"
	return ""

static func _lum(c: Color) -> float:
	return c.r * 0.3 + c.g * 0.55 + c.b * 0.15

static func _hero_mesh(src: Mesh, cols: Dictionary, key: String) -> Mesh:
	if _meshes.has(key):
		return _meshes[key]
	var out := ArrayMesh.new()
	var lin := {}
	for k in cols:
		lin[k] = (cols[k] as Color).srgb_to_linear()
	for s in src.get_surface_count():
		var arr: Array = src.surface_get_arrays(s)
		var smat: Material = src.surface_get_material(s)
		var plain := smat != null and smat.resource_name.begins_with("plain")
		var mat: Material = _material_for(smat, true)
		if arr[Mesh.ARRAY_TEX_UV] != null and arr[Mesh.ARRAY_COLOR] != null:
			var cs: PackedColorArray = arr[Mesh.ARRAY_COLOR]
			var uvs: PackedVector2Array = arr[Mesh.ARRAY_TEX_UV]
			var ps: PackedVector3Array = arr[Mesh.ARRAY_VERTEX]
			var parts := PackedStringArray()
			parts.resize(cs.size())
			var sum := {}
			var cnt := {}
			for i in cs.size():
				var part := hero_part(cs[i], uvs[i], ps[i], plain)
				parts[i] = part
				if part != "" and lin.has(part):
					sum[part] = float(sum.get(part, 0.0)) + _lum(cs[i])
					cnt[part] = int(cnt.get(part, 0)) + 1
			for i in cs.size():
				var part2: String = parts[i]
				if part2 == "" or not lin.has(part2):
					continue
				var mean: float = maxf(0.0005, float(sum[part2]) / float(cnt[part2]))
				var k := clampf(_lum(cs[i]) / mean, 0.2, 1.7)
				var tc: Color = lin[part2]
				cs[i] = Color(minf(1.0, tc.r * k), minf(1.0, tc.g * k), minf(1.0, tc.b * k), cs[i].a)
			arr[Mesh.ARRAY_COLOR] = cs
		var flags: int = src.surface_get_format(s) & Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS
		out.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr, [], {}, flags)
		out.surface_set_material(out.get_surface_count() - 1, mat)
	_meshes[key] = out
	return out

## A mount (art/mounts) in a coat: `pal` from `palette()` (empty keeps the authored colours).
static func mount(id: String, pal: Array = []) -> Node3D:
	var n := instance(MOUNTS[id], Color(0, 0, 0, 0), pal)
	n.set_meta("kind", "mount")
	return n

## The (first) mesh of a static prop, with the game's materials, for MultiMesh instancing.
static func static_mesh(rel: String) -> Mesh:
	var key := rel + "|static"
	if _meshes.has(key):
		return _meshes[key]
	var inst: Node = _scene(rel).instantiate()
	var meshes: Array = []
	_walk(inst, meshes, "MeshInstance3D")
	var out: Mesh = prepare_mesh((meshes[0] as MeshInstance3D).mesh, [], key)
	inst.free()
	return out

static func person(id: String) -> Node3D:
	var n := instance(PEOPLE[id])
	n.set_meta("kind", "person")
	return n

## A monster in an enemy's colours: `enemy` (an id in Data.ENEMIES) brings its element's accent
## and any palette it pins; without one the palette comes from the colour alone.
static func monster(shape: String, col: Color, enemy: String = "") -> Node3D:
	var d: Dictionary = Data.ENEMIES.get(enemy, {})
	var n := instance(MONSTERS[shape], col, palette(col, d.get("elem", ""), d.get("pal", {})))
	n.set_meta("kind", "monster")
	n.set_meta("shape", shape)
	return n

# ---------------------------------------------------------------- lent clips (the Living Land release)
## Every person in the game is built on one rig (art/lib/person.py make_rig), so the clips Lin Feng
## carries for doing things (INTERACT: sweeping, hammering, stirring, fishing, reading, praying, the
## towns' work of hoeing, chopping, carrying, beating a gong, calling out and eating) can be lent to
## anybody: the people of the towns (folk.gd) and the named townsfolk at their work.  A child's rig is
## the same rig scaled, so a lent clip's bone positions are scaled to it; tracks for bones a person
## does not have (a swordsman's sword) are left out.  Each model's lent clips are made once.
const LEND := ["sit_bench", "doze", "drink", "strike", "read", "play_qin", "meditate", "fish", "pray", "gather", "warm", "stir", "hammer",
	"sweep", "weave", "lift", "toss", "touch", "play_flute", "dance", "kite", "stargaze", "release", "write", "archery", "push", "gaze",
	"clap", "sword_dance", "hoe", "chop", "carry", "bang", "call", "eat"]
## the lent clips that go round and round (the rest are one-shots, played again when they end)
const LEND_LOOPS := ["sit_bench", "doze", "read", "play_qin", "meditate", "fish", "pray", "gather", "warm", "stir", "hammer", "sweep",
	"weave", "play_flute", "dance", "push", "gaze", "hoe", "chop", "carry", "bang", "eat", "write", "stargaze"]
static var _donor_lib: AnimationLibrary = null
static var _donor_hips := 0.92
static var _lent := {}

static func _skeleton(n: Node) -> Skeleton3D:
	var sks := n.find_children("*", "Skeleton3D", true, false)
	return null if sks.is_empty() else sks[0] as Skeleton3D

## Lend the party's clips to person model `n` (an instance()); a no-op for the party themselves.
static func lend_clips(n: Node3D) -> void:
	if n == null or not n.has_meta("ap"):
		return
	var ap: AnimationPlayer = n.get_meta("ap")
	if ap == null or ap.has_animation("hoe") or not has(PEOPLE.lin_feng):
		return
	if _donor_lib == null:
		var dn: Node3D = _scene(PEOPLE.lin_feng).instantiate()
		var aps: Array = []
		_walk(dn, aps, "AnimationPlayer")
		_donor_lib = (aps[0] as AnimationPlayer).get_animation_library("")
		var dsk := _skeleton(dn)
		_donor_hips = dsk.get_bone_rest(dsk.find_bone("hips")).origin.y
		dn.free()
	var rel: String = n.get_meta("glb", "")
	if not _lent.has(rel):
		var sk := _skeleton(n)
		if sk == null:
			return
		var ratio := sk.get_bone_rest(sk.find_bone("hips")).origin.y / _donor_hips
		var made := {}
		for nm in LEND:
			if not _donor_lib.has_animation(nm):
				continue
			var a: Animation = _donor_lib.get_animation(nm).duplicate(true)
			for i in range(a.get_track_count() - 1, -1, -1):
				var bone := str(a.track_get_path(i)).get_slice(":", 1)
				if bone != "" and sk.find_bone(bone) < 0:
					a.remove_track(i)
				elif absf(ratio - 1.0) > 0.005 and a.track_get_type(i) == Animation.TYPE_POSITION_3D:
					for kx in a.track_get_key_count(i):
						a.track_set_key_value(i, kx, (a.track_get_key_value(i, kx) as Vector3) * ratio)
			a.loop_mode = Animation.LOOP_LINEAR if nm in LEND_LOOPS else Animation.LOOP_NONE
			made[nm] = a
		_lent[rel] = made
	var lib: AnimationLibrary = ap.get_animation_library("")
	var lent: Dictionary = _lent[rel]
	for nm2 in lent:
		if not lib.has_animation(nm2):
			lib.add_animation(nm2, lent[nm2])

static func has_clip(n: Node3D, clip: String) -> bool:
	# (a procedural model has no player: get_meta's default of null counts as no default at all)
	if n == null or not n.has_meta("ap"):
		return false
	var ap: AnimationPlayer = n.get_meta("ap")
	return ap != null and ap.has_animation(clip)

## Drive a model's AnimationPlayer: `base` is the looping clip, an action set by Models.act()
## overrides it until it finishes.  `t` is the caller's clock (deltas are taken from it).
static func animate(n: Node3D, t: float, base: String, phase: float = 0.0) -> void:
	if not n.has_meta("ap"):
		return
	var ap: AnimationPlayer = n.get_meta("ap")
	if ap == null:
		return
	var last: float = n.get_meta("anim_t", t)
	var dt := clampf(t - last, 0.0, 0.25)
	n.set_meta("anim_t", t)
	var act: String = n.get_meta("act", "")
	if act != "":
		# a battle action a model has no clip for falls back on its attack; a gesture it cannot make
		# (Part XII, an older or a monster model) is simply skipped
		var clip := act if ap.has_animation(act) else ("attack" if ap.has_animation("attack") and act in ["cast", "hurt", "victory"] else "")
		var act_t: float = n.get_meta("act_t", 0.0)
		var e := t - act_t
		if clip != "" and e >= 0.0:
			var len_: float = ap.get_animation(clip).length
			# a fallen fighter stays down: "die" holds its last frame until another action
			if act == "die" or e <= len_ + (0.8 if act == "victory" else 0.05):
				if n.get_meta("act_seen", -INF) != act_t or ap.assigned_animation != clip:
					n.set_meta("act_seen", act_t)
					ap.play(clip, 0.08)
					ap.seek(minf(e, len_), true)
				elif ap.is_playing():
					ap.advance(dt)
				return
			n.set_meta("act", "")
		elif clip == "":
			n.set_meta("act", "")
	var want := base if ap.has_animation(base) else "idle"
	if not ap.has_animation(want):
		want = ap.get_animation_list()[0]
	if ap.assigned_animation != want or not ap.is_playing():
		var first := ap.assigned_animation == ""
		ap.play(want, 0.0 if first else 0.15)
		if first:
			ap.seek(fposmod(phase, ap.get_animation(want).length), true)
			return
	ap.advance(dt)
