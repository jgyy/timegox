class_name Assets
extends RefCounted
## Loader for the Blender-built hero assets in res://assets (see art/ and art/lib/kit.py).
##
## Every .glb is generated by a Blender Python script.  At load time the importer's materials are
## swapped for the game's own shaders so Blender models and procedural MB models share one look:
##   surface "toon"  -> MB.mat_vc()   (cel shading + ink outline)
##   surface "plain" -> MB.mat_plain()
##   surface "glow"  -> MB.mat_glow() (additive)
## UV.x is a tint weight: tinted vertices are multiplied by the colour the game asks for, so one
## mesh serves every recolour of a monster.  Animations are advanced manually from the same clock
## the procedural models use, so screenshots and the bot stay deterministic.

const DIR := "res://assets/"
const LOOPS := ["idle", "walk", "sit", "fly", "swim"]
## shape -> asset path for monsters that have a Blender model
const MONSTERS := {
	"beast": "monsters/beast", "dragon": "monsters/dragon", "phoenix": "monsters/phoenix", "bird": "monsters/phoenix",
	"golem": "monsters/golem", "tortoise": "monsters/tortoise", "scorpion": "monsters/scorpion",
	"mushroom": "monsters/mushroom", "mammoth": "monsters/mammoth", "moth": "monsters/moth", "hundun": "monsters/hundun",
	"humanoid": "monsters/humanoid", "demon": "monsters/demon",
	"fox": "monsters/fox", "carp": "monsters/carp", "oxhead": "monsters/oxhead", "horseface": "monsters/horseface", "jiangshi": "monsters/jiangshi",
	# formerly procedural-only shapes, now Blender-built
	"serpent": "monsters/serpent", "crab": "monsters/crab", "spider": "monsters/spider", "mantis": "monsters/mantis",
	"jelly": "monsters/jelly", "ray": "monsters/ray", "wisp": "monsters/wisp", "wraith": "monsters/wraith",
	"plant": "monsters/plant", "blob": "monsters/blob", "storm": "monsters/storm", "tome": "monsters/tome",
	# Part VIII
	"qilin": "monsters/qilin", "ape": "monsters/ape",
}
const PEOPLE := {
	"lin_feng": "characters/lin_feng", "yue_ling": "characters/yue_ling", "elder_qing": "characters/elder_qing",
	"alchemist": "characters/alchemist", "smith": "characters/smith", "nomad": "characters/nomad",
	"spore_witch": "characters/spore_witch", "steppe_shaman": "characters/steppe_shaman", "nuwa_echo": "characters/nuwa_echo",
	# earlier NPCs, now Blender-built too
	"sword_ghost": "characters/sword_ghost", "dragon_envoy": "characters/dragon_envoy", "fire_sage": "characters/fire_sage",
	"void_hermit": "characters/void_hermit", "gate_keeper": "characters/gate_keeper", "lake_keeper": "characters/lake_keeper",
	"grave_keeper": "characters/grave_keeper", "time_ferryman": "characters/time_ferryman", "origin_keeper": "characters/origin_keeper",
	"cloud_warden": "characters/cloud_warden", "court_scribe": "characters/court_scribe", "forge_master": "characters/forge_master",
	"peach_keeper": "characters/peach_keeper",
	# Part VI
	"lantern_monk": "characters/lantern_monk", "fisher": "characters/fisher", "meng_po": "characters/meng_po",
	"judge_cui": "characters/judge_cui", "lin_shan": "characters/lin_shan", "su_wan": "characters/su_wan",
	# Part VII
	"granny_wen": "characters/granny_wen", "innkeeper": "characters/innkeeper", "weaver_liu": "characters/weaver_liu",
	"tea_master": "characters/tea_master", "can_niang": "characters/can_niang", "apprentice_zhi": "characters/apprentice_zhi",
	"archivist": "characters/archivist",
}

static var _scenes := {}
static var _meshes := {}
static var _exists := {}
static var disabled := false

static func path(rel: String) -> String:
	return DIR + rel + ".glb"

static func has(rel: String) -> bool:
	if disabled:
		return false
	if not _exists.has(rel):
		_exists[rel] = ResourceLoader.exists(path(rel))
	return _exists[rel]

static func has_monster(shape: String) -> bool:
	return MONSTERS.has(shape) and has(MONSTERS[shape])

static func _scene(rel: String) -> PackedScene:
	if not _scenes.has(rel):
		_scenes[rel] = load(path(rel))
	return _scenes[rel]

static func _material_for(src: Material) -> Material:
	var nm := src.resource_name if src != null else "toon"
	if nm.begins_with("glow"):
		return MB.mat_glow()
	if nm.begins_with("plain"):
		return MB.mat_plain()
	return MB.mat_vc()

## Rebuild a mesh with the game's materials, tinting vertices by their UV.x weight.
static func prepare_mesh(src: Mesh, tint: Color, key: String) -> Mesh:
	if _meshes.has(key):
		return _meshes[key]
	var out := ArrayMesh.new()
	var tl := tint.srgb_to_linear()
	for s in src.get_surface_count():
		var arr: Array = src.surface_get_arrays(s)
		var mat: Material = _material_for(src.surface_get_material(s))
		if tint.a > 0.0 and arr[Mesh.ARRAY_TEX_UV] != null and arr[Mesh.ARRAY_COLOR] != null:
			var cols: PackedColorArray = arr[Mesh.ARRAY_COLOR]
			var uvs: PackedVector2Array = arr[Mesh.ARRAY_TEX_UV]
			for i in cols.size():
				var k: float = uvs[i].x
				if k > 0.001:
					var c := cols[i]
					cols[i] = Color(lerpf(c.r, c.r * tl.r, k), lerpf(c.g, c.g * tl.g, k), lerpf(c.b, c.b * tl.b, k), c.a)
			arr[Mesh.ARRAY_COLOR] = cols
		var flags: int = src.surface_get_format(s) & Mesh.ARRAY_FLAG_USE_8_BONE_WEIGHTS
		out.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr, [], {}, flags)
		out.surface_set_material(out.get_surface_count() - 1, mat)
	_meshes[key] = out
	return out

static func _walk(n: Node, out: Array, cls: String) -> void:
	if n.is_class(cls):
		out.append(n)
	for c in n.get_children():
		_walk(c, out, cls)

## Instance an asset.  tint.a == 0 keeps the authored colours.
static func instance(rel: String, tint: Color = Color(0, 0, 0, 0)) -> Node3D:
	var inst: Node3D = _scene(rel).instantiate()
	var meshes: Array = []
	_walk(inst, meshes, "MeshInstance3D")
	for mi in meshes:
		var m: MeshInstance3D = mi
		m.mesh = prepare_mesh(m.mesh, tint, "%s|%s|%s" % [rel, m.name, tint.to_html() if tint.a > 0.0 else "-"])
	var aps: Array = []
	_walk(inst, aps, "AnimationPlayer")
	var root := Node3D.new()
	root.name = rel.get_file()
	root.add_child(inst)
	if not aps.is_empty():
		var ap: AnimationPlayer = aps[0]
		ap.callback_mode_process = AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_MANUAL
		for an in ap.get_animation_list():
			var a: Animation = ap.get_animation(an)
			a.loop_mode = Animation.LOOP_LINEAR if an in LOOPS else Animation.LOOP_NONE
		root.set_meta("ap", ap)
	root.set_meta("glb", rel)
	root.set_meta("meshes", meshes)
	return root

## The (first) mesh of a static prop, with the game's materials, for MultiMesh instancing.
static func static_mesh(rel: String) -> Mesh:
	var key := rel + "|static"
	if _meshes.has(key):
		return _meshes[key]
	var inst: Node = _scene(rel).instantiate()
	var meshes: Array = []
	_walk(inst, meshes, "MeshInstance3D")
	var out: Mesh = prepare_mesh((meshes[0] as MeshInstance3D).mesh, Color(0, 0, 0, 0), key)
	inst.free()
	return out

static func person(id: String) -> Node3D:
	var n := instance(PEOPLE[id])
	n.set_meta("kind", "person")
	return n

static func monster(shape: String, col: Color) -> Node3D:
	var n := instance(MONSTERS[shape], col)
	n.set_meta("kind", "monster")
	n.set_meta("shape", shape)
	return n

## Drive a model's AnimationPlayer: `base` is the looping clip, an action set by Models.act()
## overrides it until it finishes.  `t` is the caller's clock (deltas are taken from it).
static func animate(n: Node3D, t: float, base: String, phase: float = 0.0) -> void:
	var ap: AnimationPlayer = n.get_meta("ap", null)
	if ap == null:
		return
	var last: float = n.get_meta("anim_t", t)
	var dt := clampf(t - last, 0.0, 0.25)
	n.set_meta("anim_t", t)
	var act: String = n.get_meta("act", "")
	if act != "":
		var clip := act if ap.has_animation(act) else ("attack" if ap.has_animation("attack") else "")
		var act_t: float = n.get_meta("act_t", 0.0)
		var e := t - act_t
		if clip != "" and e >= 0.0:
			var len_: float = ap.get_animation(clip).length
			if e <= len_ + (0.8 if act == "victory" else 0.05):
				if n.get_meta("act_seen", -INF) != act_t or ap.assigned_animation != clip:
					n.set_meta("act_seen", act_t)
					ap.play(clip, 0.08)
					ap.seek(minf(e, len_), true)
				elif ap.is_playing():
					ap.advance(dt)
				return
			n.set_meta("act", "")
		elif clip == "":
			n.set_meta("act", "")
	var want := base if ap.has_animation(base) else "idle"
	if not ap.has_animation(want):
		want = ap.get_animation_list()[0]
	if ap.assigned_animation != want or not ap.is_playing():
		var first := ap.assigned_animation == ""
		ap.play(want, 0.0 if first else 0.15)
		if first:
			ap.seek(fposmod(phase, ap.get_animation(want).length), true)
			return
	ap.advance(dt)
